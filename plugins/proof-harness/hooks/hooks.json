{
  "description": "Proof Harness guardrails: block destructive shell commands and keep secret files out of the agent's context. Silent unless they act. Emergency switch: PROOF_HARNESS_GUARD=off.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect-files.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
